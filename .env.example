# Copy to .env.local and adjust. Vite only exposes vars prefixed with VITE_.

# Default OpenRouter model for the tutor runtime. OpenRouter's free models
# change over time — keep this configurable rather than hardcoded in source.
# Leave blank to fall back to "openrouter/free".
VITE_FREE_OPENROUTER_MODEL=

# YouTube Data API v3 key for the lesson "Watch video" action. When set, the
# app searches for a real, relevant video and embeds it inline. When blank,
# Watch video shows "Video search is not configured" (no fake/generic video).
VITE_YOUTUBE_API_KEY=

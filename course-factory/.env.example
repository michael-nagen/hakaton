# Course Factory — environment configuration
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# NEVER commit a real API key.
#
# provider: one of  mock | openai | anthropic
#   mock      — no key needed; deterministic placeholder output for testing the
#               harness end-to-end offline. NOT real course quality.
#   openai    — any OpenAI-compatible /chat/completions endpoint.
#   anthropic — Anthropic Messages API.
COURSE_FACTORY_PROVIDER=mock

# The strong model that runs every authoring agent, e.g.:
#   openai:    gpt-4o  (or your gateway's model id)
#   anthropic: claude-opus-4-8
COURSE_FACTORY_MODEL=

# API key for the selected provider. Leave empty for provider=mock.
COURSE_FACTORY_API_KEY=

# Base URL.
#   openai:    e.g. https://api.openai.com/v1  (or any compatible gateway)
#   anthropic: defaults to https://api.anthropic.com — usually leave empty
COURSE_FACTORY_BASE_URL=

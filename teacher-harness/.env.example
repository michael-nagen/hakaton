# Teacher Harness — provider configuration
#
# Copy this file to `.env` and fill in values to run against a real
# (weak/cheap) model over an OpenAI-compatible endpoint. Leave everything
# blank to use the deterministic offline mock (the default).
#
# NEVER commit a real .env or a real API key. `.env` is gitignored.

# Provider mode: "mock" (default, offline) or "openai-compatible".
TEACHER_HARNESS_PROVIDER=mock

# Model id sent to the endpoint, e.g. "gpt-4o-mini", "llama-3.1-8b-instruct".
TEACHER_HARNESS_MODEL=

# API key for the endpoint. Injected as `Authorization: Bearer <key>`.
TEACHER_HARNESS_API_KEY=

# Base URL of an OpenAI-compatible API, e.g. "https://api.openai.com/v1".
TEACHER_HARNESS_BASE_URL=

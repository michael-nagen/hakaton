# Teacher Harness — provider configuration
#
# Copy this file to `.env` and fill in values to run against a real
# (weak/cheap) model over an OpenAI-compatible endpoint. Leave everything
# blank to use the deterministic offline mock (the default).
#
# NEVER commit a real .env or a real API key. `.env` is gitignored.

# Provider mode: "mock" (default, offline) or "openai-compatible".
TEACHER_HARNESS_PROVIDER=mock

# Model id sent to the endpoint, e.g. "gpt-4o-mini", "llama-3.1-8b-instruct".
TEACHER_HARNESS_MODEL=

# API key for the endpoint. Injected as `Authorization: Bearer <key>`.
TEACHER_HARNESS_API_KEY=

# Base URL of an OpenAI-compatible API, e.g. "https://api.openai.com/v1".
TEACHER_HARNESS_BASE_URL=

# ── LLM judge (second-pass teaching-quality evaluation) ──────────────
#
# Used ONLY by `npm run evaluate:judge` (the top-2 prompt-variant judge pass).
# The judge is a SEPARATE, strong cloud model — never the local Llama tutor.
# These override the provider config above for judging only; each key falls
# back to its TEACHER_HARNESS_* counterpart when left blank.
#
# ── Final judge = OpenAI (recommended) ──
# Set provider to "openai" and paste your OpenAI key. Model defaults to
# gpt-4.1-mini and base URL to https://api.openai.com/v1, so ONLY the key is
# required. With provider=openai it will NOT fall back to the Gemini endpoint.
TEACHER_HARNESS_JUDGE_PROVIDER=openai
TEACHER_HARNESS_JUDGE_MODEL=gpt-4.1-mini
TEACHER_HARNESS_JUDGE_API_KEY=PASTE_OPENAI_API_KEY_HERE
# Optional (defaults to https://api.openai.com/v1):
# TEACHER_HARNESS_JUDGE_BASE_URL=https://api.openai.com/v1

# Optional pacing between judge calls in ms (default 4000).
# TEACHER_HARNESS_JUDGE_CALL_DELAY_MS=4000

# ── Alternative: OpenAI-compatible judge (e.g. Gemini via OpenAI compat) ──
# TEACHER_HARNESS_JUDGE_PROVIDER=openai-compatible
# TEACHER_HARNESS_JUDGE_MODEL=gemini-flash-lite-latest   # reuses the key/base URL above

